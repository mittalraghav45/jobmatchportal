{
  "name": "JobMatchPortal Codespace",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "remoteUser": "node",
  "postStartCommand": "nohup bash .devcontainer/auto-sync.sh >/tmp/jobmatchportal-auto-sync-start.log 2>&1 &; bash .devcontainer/start-backend.sh",
  "forwardPorts": [
    3001,
    5173
  ],
  "portsAttributes": {
    "3001": {
      "label": "Backend API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Frontend",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "postCreateCommand": "cd backend && npm ci"
}
