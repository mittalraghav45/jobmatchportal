{
  "name": "sponsor-tracker-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node -r dotenv/config routes/registerJobs.js",
    "dev:node20": "node --env-file=.env routes/registerJobs.js",
    "start": "node -r dotenv/config routes/registerJobs.js",
    "test": "node --check server.js && node --test tests/*.test.js",
